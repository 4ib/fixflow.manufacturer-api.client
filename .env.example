# Copy to .env and fill in. Without FIXFLOW_BASE_URL and FIXFLOW_API_KEY the demo runs
# against the built-in mock of the FixFlow Manufacturer API — no key needed.

# API base of your FixFlow deployment, including the /fixflow segment.
# Your FixFlow contact gives you the host.
# FIXFLOW_BASE_URL=https://<your-fixflow-host>/fixflow

# Your Manufacturer API key (starts with ffmfr_). Create one on the "API keys" page of the
# FixFlow manufacturer portal, or ask your FixFlow contact. Never commit it.
# FIXFLOW_API_KEY=ffmfr_xxxxxxxxxxxx

# Local web UI of this demo. Binds to localhost only by default.
# PORT=3000
# HOST=127.0.0.1

# How often the background poller reads the change feed (seconds). FixFlow recommends 30-60.
# POLL_INTERVAL_SECONDS=30

# Where the poller keeps its cursor and the work orders it has seen.
# DATA_DIR=./data

# Mock only: seconds between simulated status changes of each work order.
# MOCK_STEP_SECONDS=15
